<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>RasgaPdf</PackageId>
    <Version>0.2.5</Version>
    <Authors>Messias Martins</Authors>
    <Description>Ultra-fast 2D spatial PDF parser powered by pure Rust for .NET — extract exact [x0, y0, x1, y1] bounding boxes, text blocks, tables, images &amp; vector paths in milliseconds</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://martinsmessias.github.io/rasgapdf/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MartinsMessias/rasgapdf</RepositoryUrl>
    <PackageTags>pdf;pdf-parser;spatial-pdf;bounding-box;table-extraction;layout-analysis;rag;llm;rust;mupdf</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\target\release\librasgapdf.so" Condition="Exists('..\..\target\release\librasgapdf.so')" Pack="true" PackagePath="runtimes/linux-x64/native/librasgapdf.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\target\release\rasgapdf.dll" Condition="Exists('..\..\target\release\rasgapdf.dll')" Pack="true" PackagePath="runtimes/win-x64/native/rasgapdf.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
